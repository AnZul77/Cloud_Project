# AWS Credentials & Region Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# Optional if using temporary AWS Academy / IAM Role credentials:
# AWS_SESSION_TOKEN=your_session_token_here

# S3 Configuration
S3_BUCKET_NAME=docucloud-ai-storage-bucket

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=DocuCloudProcessedDocuments

# SQS Configuration
SQS_QUEUE_NAME=DocuCloudHeavyProcessingQueue
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/DocuCloudHeavyProcessingQueue

# Bedrock Model ID (Claude 3 Haiku or Claude 3.5 Sonnet / Amazon Titan)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Amazon SES (Sender email verified in AWS SES)
SES_SENDER_EMAIL=admin@example.com

# EC2 App Settings
APP_HOST=0.0.0.0
APP_PORT=8000
